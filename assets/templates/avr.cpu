  instruction nop "" {
    size 16
    match 0xffff 0x0
    describe "No operation"
    exec {
    }
  }

  instruction sleep "" {
    size 16
    match 0xffff 0x9588
    describe "Sleep: stops the program in this simulator"
    exec {
      halt();
    }
  }

  instruction break "" {
    size 16
    match 0xffff 0x9598
    describe "Break: stops the program"
    exec {
      halt();
    }
  }

  pseudo "clr rd" {
    expand {
      eor rd, rd
    }
  }

  pseudo "lsl rd" {
    expand {
      add rd, rd
    }
  }

  pseudo "rol rd" {
    expand {
      adc rd, rd
    }
  }

  pseudo "tst rd" {
    expand {
      and rd, rd
    }
  }

  pseudo "ser rd" {
    expand {
      ldi rd, 255
    }
  }

  pseudo "sbr rd, imm" {
    expand {
      ori rd, imm
    }
  }

  pseudo "brlo target" {
    expand {
      brcs target
    }
  }

  pseudo "brsh target" {
    expand {
      brcc target
    }
  }

  sample """
    ; AVR (ATmega-style): add up a table through the X pointer and print the sum.
    ; Simulator console: I/O 0x0C (UDR) prints a character, 0x0D prints a number.
            .data
    table:  .byte 3, 14, 15, 9, 26

            .text
    main:
            ldi   r26, lo8(table)     ; X = r27:r26 = address of the table
            ldi   r27, hi8(table)
            clr   r18                 ; sum
            ldi   r19, 5              ; count
    loop:
            ld    r20, X+             ; load, then X++
            add   r18, r20            ; sets H S V N Z C
            dec   r19
            brne  loop                ; repeat until Z

            mov   r24, r18
            rcall show                ; call (return address goes on the stack)
            ldi   r16, 10
            out   0x0c, r16           ; newline
            sleep

    show:
            out   0x0d, r24           ; print r24 as a number
            ret
  """
}
