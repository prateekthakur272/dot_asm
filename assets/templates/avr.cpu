  instruction sec "" {
    size 16
    match 0xffff 0x9408
    describe "Set the C flag"
    exec {
      C = 1;
    }
  }

  instruction clc "" {
    size 16
    match 0xffff 0x9488
    describe "Clear the C flag"
    exec {
      C = 0;
    }
  }

