  instruction test "rm, reg" {
    size 16
    match 0xc0ff 0xc085
    operand rm reg [10:8]
    operand reg reg [13:11]
    describe "Bitwise and, flags only"
    exec {
      res = rm & reg;
      CF = 0;
      OF = 0;
      ZF = res == 0;
      SF = bit(res, 31);
