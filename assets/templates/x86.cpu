  pseudo "jz target" {
    expand {
      je target
    }
  }

  pseudo "jnz target" {
    expand {
      jne target
    }
  }

  pseudo "jc target" {
    expand {
      jb target
    }
  }

  pseudo "jnc target" {
    expand {
      jae target
    }
  }

  pseudo "jnae target" {
    expand {
      jb target
