  }

  pseudo "jnb target" {
    expand {
      jae target
    }
  }

  pseudo "jna target" {
    expand {
      jbe target
    }
  }

  pseudo "jnbe target" {
    expand {
      ja target
    }
  }

  pseudo "jnge target" {
    expand {
      jl target
    }
  }

  pseudo "jnl target" {
    expand {
      jge target
    }
  }

  pseudo "jng target" {
    expand {
      jle target
    }
  }

  pseudo "jnle target" {
    expand {
      jg target
    }
  }

  sample """
    ; x86 (32-bit, Intel syntax): sum 1..10 and print it.
    ; int 0x80 services: eax=1 exit, 2 print ebx as a number, 4 print the string at ebx.
            .data
    msg:    .asciz "sum = "
    total:  .long 0

            .text
    main:
            mov   eax, 0              ; sum
            mov   ecx, 1              ; i
    again:
            add   eax, ecx            ; sum += i   (sets ZF SF CF OF)
            inc   ecx
            cmp   ecx, 10
            jle   again               ; signed less-or-equal: ZF=1 or SF!=OF

            mov   [total], eax        ; store to an absolute address
            call  double              ; eax = eax * 2
            push  eax                 ; keep the result on the stack

            mov   ebx, msg
            mov   eax, 4
            int   0x80                ; print "sum = "
            pop   ebx
            mov   eax, 2
            int   0x80                ; print the number
            mov   eax, 1
            int   0x80                ; exit

    double:
            add   eax, eax
            ret
  """
}
