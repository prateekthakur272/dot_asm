  instruction php "" {
    size 8
    match 0xff 0x8
    cycles 2
    describe "Push the status flags"
    exec {
      mem8[256 + SP] = (N << 7) | (V << 6) | 48 | (D << 3) | (I << 2) | (Z << 1) | C;
      SP = SP - 1;
    }
  }

