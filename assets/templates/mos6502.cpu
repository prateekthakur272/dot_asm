# dot ASM processor definition. Edit here or in the processor builder.
processor mos6502 "MOS Technology 6502" {
  arch mos6502
  vendor "MOS Technology"
  year 1975
  era legacy
  tags CISC 8-bit MOS
  describe "The 8-bit processor of the Apple II, Commodore 64, NES and Atari 2600: A, X, Y registers, a 256-byte stack in page 1, 13 addressing modes and 1-3 byte instructions. Decimal mode is not simulated. hlt/prn/prc/prs are simulator extras on unused opcodes."

  word 16 little
  fetch 8
  hexprefix "$"
  wordbytes 2
  comments ";"

  register A width 8 "Accumulator"
  register X width 8 "Index register X"
  register Y width 8 "Index register Y"
  register SP width 8 "Stack pointer (stack is page 1: $0100-$01FF)"
  flags N V D I Z C
  init SP=0xff
  reset 0x800
  pipeline Fetch Decode Execute

  memory {
    ram     at 0x0 size 0x800 perms rw role data
    program at 0x800 size 0xb800 perms rx role text
  }

  instruction adc "#imm" {
    size 16
    match 0xff 0x69
    operand imm imm [15:8]
    cycles 2
    describe "Add with carry"
    exec {
      v = imm;
      t = A + v + C;
      res = t & 255;
      C = bit(t, 8);
      V = bit((A ^ res) & (v ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction adc "(zp,x)" {
    size 16
    match 0xff 0x61
    operand zp imm [15:8]
    cycles 6
    describe "Add with carry"
    exec {
      p = (zp + X) & 255;
      a = mem8[p] | (mem8[(p + 1) & 255] << 8);
      v = mem8[a];
      t = A + v + C;
      res = t & 255;
      C = bit(t, 8);
      V = bit((A ^ res) & (v ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction adc "(zp),y" {
    size 16
    match 0xff 0x71
    operand zp imm [15:8]
    cycles 5
    describe "Add with carry"
    exec {
      a = ((mem8[zp] | (mem8[(zp + 1) & 255] << 8)) + Y) & 65535;
      v = mem8[a];
      t = A + v + C;
      res = t & 255;
      C = bit(t, 8);
      V = bit((A ^ res) & (v ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction adc "zp" {
    size 16
    match 0xff 0x65
    operand zp imm [15:8]
    cycles 3
    describe "Add with carry"
    exec {
      a = zp;
      v = mem8[a];
      t = A + v + C;
      res = t & 255;
      C = bit(t, 8);
      V = bit((A ^ res) & (v ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction adc "zp,x" {
    size 16
    match 0xff 0x75
    operand zp imm [15:8]
    cycles 4
    describe "Add with carry"
    exec {
      a = (zp + X) & 255;
      v = mem8[a];
      t = A + v + C;
      res = t & 255;
      C = bit(t, 8);
      V = bit((A ^ res) & (v ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction adc "addr" {
    size 24
    match 0xff 0x6d
    operand addr imm [23:8]
    cycles 4
    describe "Add with carry"
    exec {
      a = addr;
      v = mem8[a];
      t = A + v + C;
      res = t & 255;
      C = bit(t, 8);
      V = bit((A ^ res) & (v ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction adc "addr,x" {
    size 24
    match 0xff 0x7d
    operand addr imm [23:8]
    cycles 4
    describe "Add with carry"
    exec {
      a = (addr + X) & 65535;
      v = mem8[a];
      t = A + v + C;
      res = t & 255;
      C = bit(t, 8);
      V = bit((A ^ res) & (v ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction adc "addr,y" {
    size 24
    match 0xff 0x79
    operand addr imm [23:8]
    cycles 4
    describe "Add with carry"
    exec {
      a = (addr + Y) & 65535;
      v = mem8[a];
      t = A + v + C;
      res = t & 255;
      C = bit(t, 8);
      V = bit((A ^ res) & (v ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction and "#imm" {
    size 16
    match 0xff 0x29
    operand imm imm [15:8]
    cycles 2
    describe "Bitwise and with A"
    exec {
      v = imm;
      A = A & v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction and "(zp,x)" {
    size 16
    match 0xff 0x21
    operand zp imm [15:8]
    cycles 6
    describe "Bitwise and with A"
    exec {
      p = (zp + X) & 255;
      a = mem8[p] | (mem8[(p + 1) & 255] << 8);
      v = mem8[a];
      A = A & v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction and "(zp),y" {
    size 16
    match 0xff 0x31
    operand zp imm [15:8]
    cycles 5
    describe "Bitwise and with A"
    exec {
      a = ((mem8[zp] | (mem8[(zp + 1) & 255] << 8)) + Y) & 65535;
      v = mem8[a];
      A = A & v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction and "zp" {
    size 16
    match 0xff 0x25
    operand zp imm [15:8]
    cycles 3
    describe "Bitwise and with A"
    exec {
      a = zp;
      v = mem8[a];
      A = A & v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction and "zp,x" {
    size 16
    match 0xff 0x35
    operand zp imm [15:8]
    cycles 4
    describe "Bitwise and with A"
    exec {
      a = (zp + X) & 255;
      v = mem8[a];
      A = A & v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction and "addr" {
    size 24
    match 0xff 0x2d
    operand addr imm [23:8]
    cycles 4
    describe "Bitwise and with A"
    exec {
      a = addr;
      v = mem8[a];
      A = A & v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction and "addr,x" {
    size 24
    match 0xff 0x3d
    operand addr imm [23:8]
    cycles 4
    describe "Bitwise and with A"
    exec {
      a = (addr + X) & 65535;
      v = mem8[a];
      A = A & v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction and "addr,y" {
    size 24
    match 0xff 0x39
    operand addr imm [23:8]
    cycles 4
    describe "Bitwise and with A"
    exec {
      a = (addr + Y) & 65535;
      v = mem8[a];
      A = A & v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction asl "a" {
    size 8
    match 0xff 0xa
    cycles 2
    describe "Arithmetic shift left"
    exec {
      v = A;
      C = bit(v, 7);
      res = (v << 1) & 255;
      A = res;
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction asl "zp" {
    size 16
    match 0xff 0x6
    operand zp imm [15:8]
    cycles 5
    describe "Arithmetic shift left"
    exec {
      a = zp;
      v = mem8[a];
      C = bit(v, 7);
      res = (v << 1) & 255;
      mem8[a] = res;
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction asl "zp,x" {
    size 16
    match 0xff 0x16
    operand zp imm [15:8]
    cycles 6
    describe "Arithmetic shift left"
    exec {
      a = (zp + X) & 255;
      v = mem8[a];
      C = bit(v, 7);
      res = (v << 1) & 255;
      mem8[a] = res;
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction asl "addr" {
    size 24
    match 0xff 0xe
    operand addr imm [23:8]
    cycles 6
    describe "Arithmetic shift left"
    exec {
      a = addr;
      v = mem8[a];
      C = bit(v, 7);
      res = (v << 1) & 255;
      mem8[a] = res;
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction asl "addr,x" {
    size 24
    match 0xff 0x1e
    operand addr imm [23:8]
    cycles 6
    describe "Arithmetic shift left"
    exec {
      a = (addr + X) & 65535;
      v = mem8[a];
      C = bit(v, 7);
      res = (v << 1) & 255;
      mem8[a] = res;
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction bcc "target" {
    size 16
    match 0xff 0x90
    operand target pcrel s[15:8]
    cycles 2
    base 2
    describe "Branch if carry clear"
    exec {
      if (!C) {
        pc = pc + 2 + target;
      }
    }
  }

  instruction bcs "target" {
    size 16
    match 0xff 0xb0
    operand target pcrel s[15:8]
    cycles 2
    base 2
    describe "Branch if carry set"
    exec {
      if (C) {
        pc = pc + 2 + target;
      }
    }
  }

  instruction beq "target" {
    size 16
    match 0xff 0xf0
    operand target pcrel s[15:8]
    cycles 2
    base 2
    describe "Branch if equal (zero set)"
    exec {
      if (Z) {
        pc = pc + 2 + target;
      }
    }
  }

  instruction bit "zp" {
    size 16
    match 0xff 0x24
    operand zp imm [15:8]
    cycles 3
    describe "Test bits: Z = (A & M) == 0, N and V copied from M"
    exec {
      a = zp;
      v = mem8[a];
      Z = (A & v) == 0;
      N = bit(v, 7);
      V = bit(v, 6);
    }
  }

  instruction bit "addr" {
    size 24
    match 0xff 0x2c
    operand addr imm [23:8]
    cycles 4
    describe "Test bits: Z = (A & M) == 0, N and V copied from M"
    exec {
      a = addr;
      v = mem8[a];
      Z = (A & v) == 0;
      N = bit(v, 7);
      V = bit(v, 6);
    }
  }

  instruction bmi "target" {
    size 16
    match 0xff 0x30
    operand target pcrel s[15:8]
    cycles 2
    base 2
    describe "Branch if minus"
    exec {
      if (N) {
        pc = pc + 2 + target;
      }
    }
  }

  instruction bne "target" {
    size 16
    match 0xff 0xd0
    operand target pcrel s[15:8]
    cycles 2
    base 2
    describe "Branch if not equal (zero clear)"
    exec {
      if (!Z) {
        pc = pc + 2 + target;
      }
    }
  }

  instruction bpl "target" {
    size 16
    match 0xff 0x10
    operand target pcrel s[15:8]
    cycles 2
    base 2
    describe "Branch if plus"
    exec {
      if (!N) {
        pc = pc + 2 + target;
      }
    }
  }

  instruction brk "" {
    size 8
    match 0xff 0x0
    cycles 2
    describe "Break: stops the program in this simulator"
    exec {
      halt();
    }
  }

  instruction bvc "target" {
    size 16
    match 0xff 0x50
    operand target pcrel s[15:8]
    cycles 2
    base 2
    describe "Branch if overflow clear"
    exec {
      if (!V) {
        pc = pc + 2 + target;
      }
    }
  }

  instruction bvs "target" {
    size 16
    match 0xff 0x70
    operand target pcrel s[15:8]
    cycles 2
    base 2
    describe "Branch if overflow set"
    exec {
      if (V) {
        pc = pc + 2 + target;
      }
    }
  }

  instruction clc "" {
    size 8
    match 0xff 0x18
    cycles 2
    describe "Clear carry"
    exec {
      C = 0;
    }
  }

  instruction cld "" {
    size 8
    match 0xff 0xd8
    cycles 2
    describe "Clear decimal flag (decimal mode is not simulated)"
    exec {
      D = 0;
    }
  }

  instruction cli "" {
    size 8
    match 0xff 0x58
    cycles 2
    describe "Clear interrupt disable"
    exec {
      I = 0;
    }
  }

  instruction clv "" {
    size 8
    match 0xff 0xb8
    cycles 2
    describe "Clear overflow"
    exec {
      V = 0;
    }
  }

  instruction cmp "#imm" {
    size 16
    match 0xff 0xc9
    operand imm imm [15:8]
    cycles 2
    describe "Compare A with memory"
    exec {
      v = imm;
      t = A - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cmp "(zp,x)" {
    size 16
    match 0xff 0xc1
    operand zp imm [15:8]
    cycles 6
    describe "Compare A with memory"
    exec {
      p = (zp + X) & 255;
      a = mem8[p] | (mem8[(p + 1) & 255] << 8);
      v = mem8[a];
      t = A - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cmp "(zp),y" {
    size 16
    match 0xff 0xd1
    operand zp imm [15:8]
    cycles 5
    describe "Compare A with memory"
    exec {
      a = ((mem8[zp] | (mem8[(zp + 1) & 255] << 8)) + Y) & 65535;
      v = mem8[a];
      t = A - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cmp "zp" {
    size 16
    match 0xff 0xc5
    operand zp imm [15:8]
    cycles 3
    describe "Compare A with memory"
    exec {
      a = zp;
      v = mem8[a];
      t = A - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cmp "zp,x" {
    size 16
    match 0xff 0xd5
    operand zp imm [15:8]
    cycles 4
    describe "Compare A with memory"
    exec {
      a = (zp + X) & 255;
      v = mem8[a];
      t = A - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cmp "addr" {
    size 24
    match 0xff 0xcd
    operand addr imm [23:8]
    cycles 4
    describe "Compare A with memory"
    exec {
      a = addr;
      v = mem8[a];
      t = A - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cmp "addr,x" {
    size 24
    match 0xff 0xdd
    operand addr imm [23:8]
    cycles 4
    describe "Compare A with memory"
    exec {
      a = (addr + X) & 65535;
      v = mem8[a];
      t = A - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cmp "addr,y" {
    size 24
    match 0xff 0xd9
    operand addr imm [23:8]
    cycles 4
    describe "Compare A with memory"
    exec {
      a = (addr + Y) & 65535;
      v = mem8[a];
      t = A - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cpx "#imm" {
    size 16
    match 0xff 0xe0
    operand imm imm [15:8]
    cycles 2
    describe "Compare X with memory"
    exec {
      v = imm;
      t = X - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cpx "zp" {
    size 16
    match 0xff 0xe4
    operand zp imm [15:8]
    cycles 3
    describe "Compare X with memory"
    exec {
      a = zp;
      v = mem8[a];
      t = X - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cpx "addr" {
    size 24
    match 0xff 0xec
    operand addr imm [23:8]
    cycles 4
    describe "Compare X with memory"
    exec {
      a = addr;
      v = mem8[a];
      t = X - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cpy "#imm" {
    size 16
    match 0xff 0xc0
    operand imm imm [15:8]
    cycles 2
    describe "Compare Y with memory"
    exec {
      v = imm;
      t = Y - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cpy "zp" {
    size 16
    match 0xff 0xc4
    operand zp imm [15:8]
    cycles 3
    describe "Compare Y with memory"
    exec {
      a = zp;
      v = mem8[a];
      t = Y - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction cpy "addr" {
    size 24
    match 0xff 0xcc
    operand addr imm [23:8]
    cycles 4
    describe "Compare Y with memory"
    exec {
      a = addr;
      v = mem8[a];
      t = Y - v;
      res = t & 255;
      C = 1 - bit(t, 63);
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction dec "zp" {
    size 16
    match 0xff 0xc6
    operand zp imm [15:8]
    cycles 5
    describe "Decrement memory"
    exec {
      a = zp;
      v = mem8[a];
      res = (v - 1) & 255;
      mem8[a] = res;
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction dec "zp,x" {
    size 16
    match 0xff 0xd6
    operand zp imm [15:8]
    cycles 6
    describe "Decrement memory"
    exec {
      a = (zp + X) & 255;
      v = mem8[a];
      res = (v - 1) & 255;
      mem8[a] = res;
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction dec "addr" {
    size 24
    match 0xff 0xce
    operand addr imm [23:8]
    cycles 6
    describe "Decrement memory"
    exec {
      a = addr;
      v = mem8[a];
      res = (v - 1) & 255;
      mem8[a] = res;
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction dec "addr,x" {
    size 24
    match 0xff 0xde
    operand addr imm [23:8]
    cycles 6
    describe "Decrement memory"
    exec {
      a = (addr + X) & 65535;
      v = mem8[a];
      res = (v - 1) & 255;
      mem8[a] = res;
      N = bit(res, 7);
      Z = res == 0;
    }
  }

  instruction dex "" {
    size 8
    match 0xff 0xca
    cycles 2
    describe "Decrement X"
    exec {
      X = (X - 1) & 255;
      N = bit(X, 7);
      Z = X == 0;
    }
  }

  instruction dey "" {
    size 8
    match 0xff 0x88
    cycles 2
    describe "Decrement Y"
    exec {
      Y = (Y - 1) & 255;
      N = bit(Y, 7);
      Z = Y == 0;
    }
  }

  instruction eor "#imm" {
    size 16
    match 0xff 0x49
    operand imm imm [15:8]
    cycles 2
    describe "Bitwise exclusive or with A"
    exec {
      v = imm;
      A = A ^ v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction eor "(zp,x)" {
    size 16
    match 0xff 0x41
    operand zp imm [15:8]
    cycles 6
    describe "Bitwise exclusive or with A"
    exec {
      p = (zp + X) & 255;
      a = mem8[p] | (mem8[(p + 1) & 255] << 8);
      v = mem8[a];
      A = A ^ v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction eor "(zp),y" {
    size 16
    match 0xff 0x51
    operand zp imm [15:8]
    cycles 5
    describe "Bitwise exclusive or with A"
    exec {
      a = ((mem8[zp] | (mem8[(zp + 1) & 255] << 8)) + Y) & 65535;
      v = mem8[a];
      A = A ^ v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction eor "zp" {
    size 16
    match 0xff 0x45
    operand zp imm [15:8]
    cycles 3
    describe "Bitwise exclusive or with A"
    exec {
      a = zp;
      v = mem8[a];
      A = A ^ v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction eor "zp,x" {
    size 16
    match 0xff 0x55
    operand zp imm [15:8]
    cycles 4
    describe "Bitwise exclusive or with A"
    exec {
      a = (zp + X) & 255;
      v = mem8[a];
      A = A ^ v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction eor "addr" {
    size 24
    match 0xff 0x4d
    operand addr imm [23:8]
    cycles 4
    describe "Bitwise exclusive or with A"
    exec {
      a = addr;
      v = mem8[a];
      A = A ^ v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction eor "addr,x" {
    size 24
    match 0xff 0x5d
    operand addr imm [23:8]
    cycles 4
    describe "Bitwise exclusive or with A"
    exec {
      a = (addr + X) & 65535;
      v = mem8[a];
      A = A ^ v;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction eor "addr,y" {
    size 24
    match 0xff 0x59
    operand addr imm [23:8]
    cycles 4
    describe "Bitwise exclusive or with A"
    exec {
      a = (addr + Y) & 65535;
