  instruction sbc "#imm" {
    size 16
    match 0xff 0xe9
    operand imm imm [15:8]
    cycles 2
    describe "Subtract with carry (borrow)"
    exec {
      v = imm;
      t = A - v - 1 + C;
      res = t & 255;
      C = 1 - bit(t, 63);
      V = bit((A ^ v) & (A ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

