      t = A - v - 1 + C;
      res = t & 255;
      C = 1 - bit(t, 63);
      V = bit((A ^ v) & (A ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction sbc "addr,y" {
    size 24
    match 0xff 0xf9
    operand addr imm [23:8]
    cycles 4
    describe "Subtract with carry (borrow)"
    exec {
      a = (addr + Y) & 65535;
      v = mem8[a];
      t = A - v - 1 + C;
      res = t & 255;
      C = 1 - bit(t, 63);
      V = bit((A ^ v) & (A ^ res), 7);
      A = res;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction sec "" {
    size 8
    match 0xff 0x38
    cycles 2
    describe "Set carry"
    exec {
      C = 1;
    }
  }

  instruction sed "" {
    size 8
    match 0xff 0xf8
    cycles 2
    describe "Set decimal flag (decimal mode is not simulated)"
    exec {
      D = 1;
    }
  }

  instruction sei "" {
    size 8
    match 0xff 0x78
    cycles 2
    describe "Set interrupt disable"
    exec {
      I = 1;
    }
  }

  instruction sta "(zp,x)" {
    size 16
    match 0xff 0x81
    operand zp imm [15:8]
    cycles 6
    describe "Store A"
    exec {
      p = (zp + X) & 255;
      a = mem8[p] | (mem8[(p + 1) & 255] << 8);
      mem8[a] = A;
    }
  }

  instruction sta "(zp),y" {
    size 16
    match 0xff 0x91
    operand zp imm [15:8]
    cycles 5
    describe "Store A"
    exec {
      a = ((mem8[zp] | (mem8[(zp + 1) & 255] << 8)) + Y) & 65535;
      mem8[a] = A;
    }
  }

  instruction sta "zp" {
    size 16
    match 0xff 0x85
    operand zp imm [15:8]
    cycles 3
    describe "Store A"
    exec {
      a = zp;
      mem8[a] = A;
    }
  }

  instruction sta "zp,x" {
    size 16
    match 0xff 0x95
    operand zp imm [15:8]
    cycles 4
    describe "Store A"
    exec {
      a = (zp + X) & 255;
      mem8[a] = A;
    }
  }

  instruction sta "addr" {
    size 24
    match 0xff 0x8d
    operand addr imm [23:8]
    cycles 4
    describe "Store A"
    exec {
      a = addr;
      mem8[a] = A;
    }
  }

  instruction sta "addr,x" {
    size 24
    match 0xff 0x9d
    operand addr imm [23:8]
    cycles 4
    describe "Store A"
    exec {
      a = (addr + X) & 65535;
      mem8[a] = A;
    }
  }

  instruction sta "addr,y" {
    size 24
    match 0xff 0x99
    operand addr imm [23:8]
    cycles 4
    describe "Store A"
    exec {
      a = (addr + Y) & 65535;
      mem8[a] = A;
    }
  }

  instruction stx "zp" {
    size 16
    match 0xff 0x86
    operand zp imm [15:8]
    cycles 3
    describe "Store X"
    exec {
      a = zp;
      mem8[a] = X;
    }
  }

  instruction stx "zp,y" {
    size 16
    match 0xff 0x96
    operand zp imm [15:8]
    cycles 4
    describe "Store X"
    exec {
      a = (zp + Y) & 255;
      mem8[a] = X;
    }
  }

  instruction stx "addr" {
    size 24
    match 0xff 0x8e
    operand addr imm [23:8]
    cycles 4
    describe "Store X"
    exec {
      a = addr;
      mem8[a] = X;
    }
  }

  instruction sty "zp" {
    size 16
    match 0xff 0x84
    operand zp imm [15:8]
    cycles 3
    describe "Store Y"
    exec {
      a = zp;
      mem8[a] = Y;
    }
  }

  instruction sty "zp,x" {
    size 16
    match 0xff 0x94
    operand zp imm [15:8]
    cycles 4
    describe "Store Y"
    exec {
      a = (zp + X) & 255;
      mem8[a] = Y;
    }
  }

  instruction sty "addr" {
    size 24
    match 0xff 0x8c
    operand addr imm [23:8]
    cycles 4
    describe "Store Y"
    exec {
      a = addr;
      mem8[a] = Y;
    }
  }

  instruction tax "" {
    size 8
    match 0xff 0xaa
    cycles 2
    describe "Transfer A to X"
    exec {
      X = A;
      N = bit(X, 7);
      Z = X == 0;
    }
  }

  instruction tay "" {
    size 8
    match 0xff 0xa8
    cycles 2
    describe "Transfer A to Y"
    exec {
      Y = A;
      N = bit(Y, 7);
      Z = Y == 0;
    }
  }

  instruction tsx "" {
    size 8
    match 0xff 0xba
    cycles 2
    describe "Transfer stack pointer to X"
    exec {
      X = SP;
      N = bit(X, 7);
      Z = X == 0;
    }
  }

  instruction txa "" {
    size 8
    match 0xff 0x8a
    cycles 2
    describe "Transfer X to A"
    exec {
      A = X;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  instruction txs "" {
    size 8
    match 0xff 0x9a
    cycles 2
    describe "Transfer X to stack pointer"
    exec {
      SP = X;
    }
  }

  instruction tya "" {
    size 8
    match 0xff 0x98
    cycles 2
    describe "Transfer Y to A"
    exec {
      A = Y;
      N = bit(A, 7);
      Z = A == 0;
    }
  }

  sample """
    ; MOS 6502: add up a table, print the sum, then double it in a subroutine.
    ; $ marks hexadecimal. Simulator extras: prn prints A as a number, prc as a
    ; character, prs addr prints a string, hlt (or brk) stops.
            .data
    table:  .byte 3, 14, 15, 9, 26     ; lives in zero page, address $0000

            .text
    main:   ldx #0                     ; index
            lda #0                     ; sum
    loop:   clc
            adc table,x                ; zero-page indexed addressing
            inx
            cpx #5
            bne loop                   ; Z flag: loop until X == 5

            prn                        ; prints 67
            lda #$0A
            prc                        ; newline
            lda #67
            jsr twice                  ; stack holds the return address
            prn                        ; prints 134
            hlt

    twice:  asl a                      ; A = A * 2
            rts
  """
}
