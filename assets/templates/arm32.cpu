# dot ASM processor definition. Edit here or in the processor builder.
processor arm32 "ARM (ARMv7-A, A32 subset)" {
  arch arm
  vendor "Arm"
  year 1985
  era modern
  tags RISC ARM 32-bit
  describe "The 32-bit ARM instruction set: every instruction can be conditional (addeq, movlt, bne), data-processing with flags, load/store, push/pop and BL/BX calls. Subset: immediates are 0-255 (use movw/movt or ldr rd, =value for more), no shifted-register operands, r15/PC is not a general register."

  word 32 little
  fetch 32
  aligned
  comments "@" ";" "//"

  registers r count 15 width 32 {
    alias fp=11 ip=12 sp=13 lr=14
  }
  flags N Z C V
  init sp=0x2fff0
  reset 0x8000
  pipeline Fetch Decode Execute

  memory {
    text  at 0x8000 size 0x8000 perms rx role text
    data  at 0x10000 size 0x10000 perms rw role data
    stack at 0x20000 size 0x10000 perms rw role stack
  }

  conditions field [31:28] default 14 {
    eq 0 when Z
    ne 1 when !Z
    cs 2 when C
    cc 3 when !C
    mi 4 when N
    pl 5 when !N
    vs 6 when V
    vc 7 when !V
    hi 8 when C && !Z
    ls 9 when !C || Z
    ge 10 when N == V
    lt 11 when N != V
    gt 12 when !Z && N == V
    le 13 when Z || N != V
    al 14 when 1
  }

  instruction and "rd, rn, rm" {
    size 32
    match 0xff00ff0 0x0
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand rm reg [3:0]
    conditional
    describe "Bitwise and"
    exec {
      v = rm;
      res = rn & v;
      rd = res;
    }
  }

  instruction and "rd, rn, #imm" {
    size 32
    match 0xff00f00 0x2000000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [7:0]
    conditional
    describe "Bitwise and"
    exec {
      v = imm;
      res = rn & v;
      rd = res;
    }
  }

  instruction ands "rd, rn, rm" {
    size 32
    match 0xff00ff0 0x100000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand rm reg [3:0]
    conditional
    describe "Bitwise and and set flags"
    exec {
      v = rm;
      res = rn & v;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
    }
  }

  instruction ands "rd, rn, #imm" {
    size 32
    match 0xff00f00 0x2100000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [7:0]
    conditional
    describe "Bitwise and and set flags"
    exec {
      v = imm;
      res = rn & v;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
    }
  }

  instruction eor "rd, rn, rm" {
    size 32
    match 0xff00ff0 0x200000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand rm reg [3:0]
    conditional
    describe "Bitwise exclusive or"
    exec {
      v = rm;
      res = rn ^ v;
      rd = res;
    }
  }

  instruction eor "rd, rn, #imm" {
    size 32
    match 0xff00f00 0x2200000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [7:0]
    conditional
    describe "Bitwise exclusive or"
    exec {
      v = imm;
      res = rn ^ v;
      rd = res;
    }
  }

  instruction eors "rd, rn, rm" {
    size 32
    match 0xff00ff0 0x300000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand rm reg [3:0]
    conditional
    describe "Bitwise exclusive or and set flags"
    exec {
      v = rm;
      res = rn ^ v;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
    }
  }

  instruction eors "rd, rn, #imm" {
    size 32
    match 0xff00f00 0x2300000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [7:0]
    conditional
    describe "Bitwise exclusive or and set flags"
    exec {
      v = imm;
      res = rn ^ v;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
    }
  }

  instruction sub "rd, rn, rm" {
    size 32
    match 0xff00ff0 0x400000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand rm reg [3:0]
    conditional
    describe "Subtract"
    exec {
      v = rm;
      t = rn - v;
      res = t & 4294967295;
      rd = res;
    }
  }

  instruction sub "rd, rn, #imm" {
    size 32
    match 0xff00f00 0x2400000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [7:0]
    conditional
    describe "Subtract"
    exec {
      v = imm;
      t = rn - v;
      res = t & 4294967295;
      rd = res;
    }
  }

  instruction subs "rd, rn, rm" {
    size 32
    match 0xff00ff0 0x500000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand rm reg [3:0]
    conditional
    describe "Subtract and set flags"
    exec {
      v = rm;
      t = rn - v;
      res = t & 4294967295;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
      C = 1 - bit(t, 63);
      V = bit((rn ^ v) & (rn ^ res), 31);
    }
  }

  instruction subs "rd, rn, #imm" {
    size 32
    match 0xff00f00 0x2500000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [7:0]
    conditional
    describe "Subtract and set flags"
    exec {
      v = imm;
      t = rn - v;
      res = t & 4294967295;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
      C = 1 - bit(t, 63);
      V = bit((rn ^ v) & (rn ^ res), 31);
    }
  }

  instruction rsb "rd, rn, rm" {
    size 32
    match 0xff00ff0 0x600000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand rm reg [3:0]
    conditional
    describe "Reverse subtract (op2 - rn)"
    exec {
      v = rm;
      t = v - rn;
      res = t & 4294967295;
      rd = res;
    }
  }

  instruction rsb "rd, rn, #imm" {
    size 32
    match 0xff00f00 0x2600000
    operand rd reg [15:12]
    operand rn reg [19:16]
