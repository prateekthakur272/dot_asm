  }

  instruction strb "rd, [rn, #-imm]" {
    size 32
    match 0xff00000 0x5400000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Store byte (negative offset)"
    exec {
      mem8[rn - imm] = rd;
    }
  }

  instruction str "rd, [rn, #-imm]!" {
    size 32
    match 0xff00000 0x5200000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Store word (pre-decrement, write back)"
    exec {
      t = rn - imm;
      mem32[t] = rd;
      rn = t;
    }
  }

  instruction ldr "rd, [rn], #imm" {
    size 32
    match 0xff00000 0x4900000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Load word (post-increment, write back)"
    exec {
      t = rn;
      rd = mem32[t];
      rn = t + imm;
    }
  }

  instruction strb "rd, [rn, #-imm]!" {
    size 32
    match 0xff00000 0x5600000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Store byte (pre-decrement, write back)"
    exec {
      t = rn - imm;
      mem8[t] = rd;
      rn = t;
    }
  }

  instruction ldrb "rd, [rn], #imm" {
    size 32
    match 0xff00000 0x4d00000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Load byte (post-increment, write back)"
    exec {
      t = rn;
      rd = mem8[t];
      rn = t + imm;
    }
  }

  instruction movw "rd, #imm" {
    size 32
    match 0xff00000 0x3000000
    operand rd reg [15:12]
    operand imm imm [19:16,11:0]
    conditional
    describe "Move a 16-bit immediate (clears the upper half)"
    exec {
      rd = imm;
    }
  }

  instruction movt "rd, #imm" {
    size 32
    match 0xff00000 0x3400000
    operand rd reg [15:12]
    operand imm imm [19:16,11:0]
    conditional
    describe "Move a 16-bit immediate into the upper half"
    exec {
      rd = (rd & 65535) | (imm << 16);
    }
  }

  instruction svc "#imm" {
    size 32
    match 0xf000000 0xf000000
    operand imm imm [23:0]
    conditional
    describe "Supervisor call: #1 exit, #2 print r0 as int, #3 print r0 as char, #4 print string at r0"
    exec {
      if (imm == 1) {
        halt();
      } else if (imm == 2) {
        out("int", r0);
      } else if (imm == 3) {
        out("char", r0);
      } else if (imm == 4) {
        out("str", r0);
      } else {
        trap("Unsupported svc number (1 exit, 2 print int, 3 print char, 4 print string)");
      }
    }
  }

  pseudo "nop" {
    expand {
      mov r0, r0
    }
  }

  pseudo "mov rd, #imm" {
    when "imm >= 0 && imm <= 65535" {
      movw rd, #imm
    }
    otherwise {
      movw rd, #(imm) & 65535
      movt rd, #((imm) >> 16) & 65535
    }
  }

  pseudo "ldr rd, =imm" {
    when "imm >= 0 && imm <= 65535" {
      movw rd, #imm
    }
    otherwise {
      movw rd, #(imm) & 65535
      movt rd, #((imm) >> 16) & 65535
    }
  }

  pseudo "neg rd, rm" {
    expand {
      rsb rd, rm, #0
    }
  }

  pseudo "ret" {
    expand {
      bx lr
    }
  }

  pseudo "push {a}" {
    expand {
      str a, [sp, #-4]!
    }
  }

  pseudo "push {a, b}" {
    expand {
      str b, [sp, #-4]!
      str a, [sp, #-4]!
    }
  }

  pseudo "push {a, b, c}" {
    expand {
      str c, [sp, #-4]!
      str b, [sp, #-4]!
      str a, [sp, #-4]!
    }
  }

  pseudo "push {a, b, c, d}" {
    expand {
      str d, [sp, #-4]!
      str c, [sp, #-4]!
      str b, [sp, #-4]!
      str a, [sp, #-4]!
    }
  }

  pseudo "pop {a}" {
    expand {
      ldr a, [sp], #4
    }
  }

  pseudo "pop {a, b}" {
    expand {
      ldr a, [sp], #4
      ldr b, [sp], #4
    }
  }

  pseudo "pop {a, b, c}" {
    expand {
      ldr a, [sp], #4
      ldr b, [sp], #4
      ldr c, [sp], #4
    }
  }

  pseudo "pop {a, b, c, d}" {
    expand {
      ldr a, [sp], #4
      ldr b, [sp], #4
      ldr c, [sp], #4
      ldr d, [sp], #4
    }
  }

  sample """
    @ Sum 1..10, call a function that doubles it, then print the result.
    @ svc #1 exit, #2 print r0 as a number, #4 print the string at r0.
            .data
    msg:    .asciz "result = "

            .text
    main:
            mov   r0, #0          @ sum
            mov   r1, #1          @ i
    loop:
            add   r0, r0, r1      @ sum += i
            add   r1, r1, #1      @ i++
            cmp   r1, #10         @ compare i with 10 (sets N Z C V)
            ble   loop            @ conditional branch: i <= 10

            bl    double          @ call: r0 = r0 * 2
            mov   r4, r0          @ keep the result

            ldr   r0, =msg
            svc   #4              @ print string
            mov   r0, r4
            svc   #2              @ print integer
            svc   #1              @ exit

    double:
            push  {lr}
            add   r0, r0, r0
            pop   {lr}
            bx    lr
  """
}
