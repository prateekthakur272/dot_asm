    operand rd reg [15:12]
    operand rn reg [19:16]
    operand rm reg [3:0]
    conditional
    describe "Reverse subtract (op2 - rn) and set flags"
    exec {
      v = rm;
      t = v - rn;
      res = t & 4294967295;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
      C = 1 - bit(t, 63);
      V = bit((v ^ rn) & (v ^ res), 31);
    }
  }

  instruction rsbs "rd, rn, #imm" {
    size 32
    match 0xff00f00 0x2700000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [7:0]
    conditional
    describe "Reverse subtract (op2 - rn) and set flags"
    exec {
      v = imm;
      t = v - rn;
      res = t & 4294967295;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
      C = 1 - bit(t, 63);
      V = bit((v ^ rn) & (v ^ res), 31);
    }
  }

  instruction add "rd, rn, rm" {
    size 32
    match 0xff00ff0 0x800000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand rm reg [3:0]
    conditional
    describe "Add"
    exec {
      v = rm;
