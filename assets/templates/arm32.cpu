  instruction lsl "rd, rm, #imm" {
    size 32
    match 0xfff0070 0x1a00000
    operand rd reg [15:12]
    operand rm reg [3:0]
    operand imm imm [11:7]
    conditional
    describe "Logical shift left by an immediate (0 = no shift)"
    exec {
      res = (rm << imm) & 4294967295;
      rd = res;
    }
  }

  instruction lsls "rd, rm, #imm" {
    size 32
    match 0xfff0070 0x1b00000
    operand rd reg [15:12]
    operand rm reg [3:0]
    operand imm imm [11:7]
    conditional
    describe "Logical shift left by an immediate (0 = no shift) and set flags"
    exec {
      res = (rm << imm) & 4294967295;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
      C = imm == 0 ? C : bit(rm, 32 - imm);
    }
  }

  instruction lsr "rd, rm, #imm" {
    size 32
    match 0xfff0070 0x1a00020
    operand rd reg [15:12]
    operand rm reg [3:0]
    operand imm imm [11:7]
    conditional
    describe "Logical shift right by an immediate (0 = no shift)"
    exec {
      res = (rm >> imm) & 4294967295;
      rd = res;
    }
  }

  instruction lsrs "rd, rm, #imm" {
    size 32
    match 0xfff0070 0x1b00020
    operand rd reg [15:12]
    operand rm reg [3:0]
    operand imm imm [11:7]
    conditional
    describe "Logical shift right by an immediate (0 = no shift) and set flags"
    exec {
      res = (rm >> imm) & 4294967295;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
      C = imm == 0 ? C : bit(rm, imm - 1);
    }
  }

  instruction asr "rd, rm, #imm" {
    size 32
    match 0xfff0070 0x1a00040
    operand rd reg [15:12]
    operand rm reg [3:0]
    operand imm imm [11:7]
    conditional
    describe "Arithmetic shift right by an immediate (0 = no shift)"
    exec {
      res = (sra(rm, imm)) & 4294967295;
      rd = res;
    }
  }

  instruction asrs "rd, rm, #imm" {
    size 32
    match 0xfff0070 0x1b00040
    operand rd reg [15:12]
    operand rm reg [3:0]
    operand imm imm [11:7]
    conditional
    describe "Arithmetic shift right by an immediate (0 = no shift) and set flags"
    exec {
      res = (sra(rm, imm)) & 4294967295;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
      C = imm == 0 ? C : bit(rm, imm - 1);
    }
  }

  instruction ror "rd, rm, #imm" {
    size 32
    match 0xfff0070 0x1a00060
    operand rd reg [15:12]
    operand rm reg [3:0]
    operand imm imm [11:7]
    conditional
    describe "Rotate right by an immediate (0 = no shift)"
    exec {
      res = (ror(rm, imm)) & 4294967295;
      rd = res;
    }
  }

  instruction rors "rd, rm, #imm" {
    size 32
    match 0xfff0070 0x1b00060
    operand rd reg [15:12]
    operand rm reg [3:0]
    operand imm imm [11:7]
    conditional
    describe "Rotate right by an immediate (0 = no shift) and set flags"
    exec {
      res = (ror(rm, imm)) & 4294967295;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
      C = imm == 0 ? C : bit(rm, imm - 1);
    }
  }

  instruction mul "rd, rm, rs" {
    size 32
    match 0xff0f0f0 0x90
    operand rd reg [19:16]
    operand rm reg [3:0]
    operand rs reg [11:8]
    cycles 3
    conditional
    describe "Multiply (low 32 bits)"
    exec {
      res = (rm * rs) & 4294967295;
      rd = res;
    }
  }

  instruction muls "rd, rm, rs" {
    size 32
    match 0xff0f0f0 0x100090
    operand rd reg [19:16]
    operand rm reg [3:0]
    operand rs reg [11:8]
    cycles 3
    conditional
    describe "Multiply (low 32 bits) and set flags"
    exec {
      res = (rm * rs) & 4294967295;
      rd = res;
      N = bit(res, 31);
      Z = res == 0;
    }
  }

  instruction b "target" {
    size 32
    match 0xf000000 0xa000000
    operand target pcrel s[23:0]<<2
    base 8
    conditional
    describe "Branch"
    exec {
      pc = pc + 8 + target;
    }
  }

  instruction bl "target" {
    size 32
    match 0xf000000 0xb000000
    operand target pcrel s[23:0]<<2
    base 8
    conditional
    describe "Branch with link (call)"
    exec {
      lr = next;
      pc = pc + 8 + target;
    }
  }

  instruction bx "rm" {
    size 32
    match 0xffffff0 0x12fff10
    operand rm reg [3:0]
    conditional
    describe "Branch to register (return with bx lr)"
    exec {
      pc = rm & ~1;
    }
  }

  instruction ldr "rd, [rn]" {
    size 32
    match 0xff00fff 0x5900000
    operand rd reg [15:12]
    operand rn reg [19:16]
    cycles 2
    conditional
    describe "Load word"
    exec {
      rd = mem32[rn];
    }
  }

  instruction ldr "rd, [rn, #imm]" {
    size 32
    match 0xff00000 0x5900000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Load word (offset)"
    exec {
      rd = mem32[rn + imm];
    }
  }

  instruction ldr "rd, [rn, #-imm]" {
    size 32
    match 0xff00000 0x5100000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Load word (negative offset)"
    exec {
      rd = mem32[rn - imm];
    }
  }

  instruction str "rd, [rn]" {
    size 32
    match 0xff00fff 0x5800000
    operand rd reg [15:12]
    operand rn reg [19:16]
    cycles 2
    conditional
    describe "Store word"
    exec {
      mem32[rn] = rd;
    }
  }

  instruction str "rd, [rn, #imm]" {
    size 32
    match 0xff00000 0x5800000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Store word (offset)"
    exec {
      mem32[rn + imm] = rd;
    }
  }

  instruction str "rd, [rn, #-imm]" {
    size 32
    match 0xff00000 0x5000000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Store word (negative offset)"
    exec {
      mem32[rn - imm] = rd;
    }
  }

  instruction ldrb "rd, [rn]" {
    size 32
    match 0xff00fff 0x5d00000
    operand rd reg [15:12]
    operand rn reg [19:16]
    cycles 2
    conditional
    describe "Load byte"
    exec {
      rd = mem8[rn];
    }
  }

  instruction ldrb "rd, [rn, #imm]" {
    size 32
    match 0xff00000 0x5d00000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Load byte (offset)"
    exec {
      rd = mem8[rn + imm];
    }
  }

  instruction ldrb "rd, [rn, #-imm]" {
    size 32
    match 0xff00000 0x5500000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Load byte (negative offset)"
    exec {
      rd = mem8[rn - imm];
    }
  }

  instruction strb "rd, [rn]" {
    size 32
    match 0xff00fff 0x5c00000
    operand rd reg [15:12]
    operand rn reg [19:16]
    cycles 2
    conditional
    describe "Store byte"
    exec {
      mem8[rn] = rd;
    }
  }

  instruction strb "rd, [rn, #imm]" {
    size 32
    match 0xff00000 0x5c00000
    operand rd reg [15:12]
    operand rn reg [19:16]
    operand imm imm [11:0]
    cycles 2
    conditional
    describe "Store byte (offset)"
    exec {
      mem8[rn + imm] = rd;
