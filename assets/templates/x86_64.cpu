  pseudo "mov reg, imm" {
    expand {
      mov reg, ((imm) >> 48) & 65535
      shl reg, 16
      or reg, ((imm) >> 32) & 65535
      shl reg, 16
      or reg, ((imm) >> 16) & 65535
      shl reg, 16
      or reg, (imm) & 65535
    }
  }

  sample """
    ; x86-64 (Intel syntax): sum 1..10, double it in a function, print it.
    ; syscall services (simulator): rax=1 exit, 2 print rdi as a number, 4 print the string at rdi.
            .data
    msg:    .asciz "sum = "
    total:  .quad 0

            .text
    main:
            mov   rax, 0              ; sum (64-bit registers, REX.W prefix)
            mov   rcx, 1              ; i
    again:
            add   rax, rcx
            inc   rcx
            cmp   rcx, 10
            jle   again

            mov   [total], rax        ; absolute address through a SIB byte
            call  double
            push  rax

            mov   rdi, msg
            mov   rax, 4
            syscall                   ; print "sum = "
            pop   rdi
            mov   rax, 2
            syscall                   ; print the number
            mov   rax, 1
            syscall                   ; exit

    double:
            add   rax, rax
            ret
  """
}
