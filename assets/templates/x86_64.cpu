  instruction syscall "" {
    size 16
    match 0xffff 0x50f
    describe "System call. Simulator services: rax=1 exit, 2 print rdi as int, 3 print rdi as char, 4 print string at rdi"
    exec {
      if (rax == 1) {
        halt();
      } else if (rax == 2) {
        out("int", rdi);
      } else if (rax == 3) {
        out("char", rdi);
      } else if (rax == 4) {
        out("str", rdi);
      } else {
        trap("Unsupported syscall (rax: 1 exit, 2 print int rdi, 3 print char rdi, 4 print string at rdi)");
      }
    }
  }

  instruction test "rm, reg" {
    size 24
    match 0xc0ffff 0xc08548
    operand rm reg [18:16]
    operand reg reg [21:19]
    describe "Bitwise and, flags only"
    exec {
      res = rm & reg;
      CF = 0;
      OF = 0;
      ZF = res == 0;
      SF = bit(res, 63);
    }
  }

  instruction xor "rm, reg" {
    size 24
    match 0xc0ffff 0xc03148
    operand rm reg [18:16]
    operand reg reg [21:19]
    describe "Bitwise xor register to register"
    exec {
      res = rm ^ reg;
      CF = 0;
      OF = 0;
      ZF = res == 0;
      SF = bit(res, 63);
      rm = res;
    }
  }

